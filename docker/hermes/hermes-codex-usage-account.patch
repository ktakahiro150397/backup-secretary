+def _codex_usage_account_id(token: str) -> Optional[str]:
+    # Read routing metadata from the selected token, not another credential's
+    # singleton store. The backend still authenticates the bearer token.
+    claims = _decode_jwt_claims(token)
+    auth = claims.get("https://api.openai.com/auth")
+    if not isinstance(auth, dict):
+        return None
+    account_id = auth.get("chatgpt_account_id")
+    if not isinstance(account_id, str):
+        return None
+    account_id = account_id.strip()
+    if not account_id or not account_id.isascii() or any(ord(c) < 33 or ord(c) == 127 for c in account_id):
+        return None
+    return account_id
+
