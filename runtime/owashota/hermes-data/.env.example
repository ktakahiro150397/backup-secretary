# 身内向け Hermes インスタンス env
#
# このファイルを .env にコピーして使う。
#   cp runtime/owashota/hermes-data/.env.example runtime/owashota/hermes-data/.env
#
# この .env は hermes-owashota コンテナ内に読み込まれる。
# 個人用 hermes-main とは値を混ぜない。

# OpenViking memory namespace
# hermes-main と混ざらないよう、必ず別値にする。
OPENVIKING_ACCOUNT=hermes-owashota
OPENVIKING_USER=hermes-owashota
OPENVIKING_AGENT=hermes-owashota
OPENVIKING_API_KEY=replace-me-owashota

# LLM / provider secrets
# 実際の変数名は利用するHermes provider設定に合わせて追加する。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=

# Messaging gateway secrets
# mainとは別Discord bot tokenを使う。
# 実際の変数名は Hermes setup / Discord 設定に合わせて追加する。
# DISCORD_TOKEN=
