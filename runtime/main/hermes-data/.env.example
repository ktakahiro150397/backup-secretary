# 個人用 Hermes インスタンス env
#
# このファイルを .env にコピーして使う。
#   cp runtime/main/hermes-data/.env.example runtime/main/hermes-data/.env
#
# この .env は hermes-main コンテナ内に読み込まれる。
# root の .env ではなく、インスタンス固有の秘密情報・接続情報を書く。

# OpenViking memory namespace
# hermes-owashota と混ざらないよう、必ず別値にする。
OPENVIKING_ACCOUNT=personal
OPENVIKING_USER=yanelmo
OPENVIKING_AGENT=hermes-main
OPENVIKING_API_KEY=replace-me-main

# LLM / provider secrets
# 実際の変数名は利用するHermes provider設定に合わせて追加する。
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=
# MOONSHOT_API_KEY=

# Messaging gateway secrets
# 実際の変数名は Hermes setup / Discord 設定に合わせて追加する。
# DISCORD_TOKEN=
