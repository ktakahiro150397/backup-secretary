# Docker image. HERMES_IMAGE is the local image built from HERMES_BASE_IMAGE.
HERMES_IMAGE=backup-secretary/hermes-agent:local
HERMES_BASE_IMAGE=nousresearch/hermes-agent:latest
HERMES_UID=1000
HERMES_GID=1000
HERMES_READ_ONLY=false

# Local-only binds by default. Expose via VPN/Tailscale only when needed.
HERMES_MAIN_GATEWAY_BIND=127.0.0.1
HERMES_MAIN_GATEWAY_PORT=8642
HERMES_OWASHOTA_GATEWAY_BIND=127.0.0.1
HERMES_OWASHOTA_GATEWAY_PORT=8643
HERMES_DASHBOARD_BIND=127.0.0.1
HERMES_DASHBOARD_PORT=9119

# Runtime directories. These stay inside this repository for the rework branch.
HERMES_MAIN_DATA_DIR=./runtime/main/hermes-data
HERMES_OWASHOTA_DATA_DIR=./runtime/owashota/hermes-data
HERMES_WORKSPACE_DIR=./workspace
HERMES_MANAGED_SKILLS_DIR=./skills

# Resource limits.
HERMES_MAIN_CPU_LIMIT=2
HERMES_MAIN_MEMORY_LIMIT=4g
HERMES_MAIN_SHM_SIZE=1g
HERMES_OWASHOTA_CPU_LIMIT=1
HERMES_OWASHOTA_MEMORY_LIMIT=2g
HERMES_OWASHOTA_SHM_SIZE=512m
HERMES_DASHBOARD_CPU_LIMIT=0.5
HERMES_DASHBOARD_MEMORY_LIMIT=512m

# OpenViking long-term memory provider.
# Build context can be a local clone or a remote Git context.
OPENVIKING_BUILD_CONTEXT=https://github.com/volcengine/OpenViking.git#main
OPENVIKING_BIND=127.0.0.1
OPENVIKING_PORT=1933
OPENVIKING_DATA_DIR=./runtime/openviking
OPENVIKING_CPU_LIMIT=1
OPENVIKING_MEMORY_LIMIT=2g
OPENVIKING_WITH_BOT=0

# Self-hosted SearXNG search.
SEARXNG_BIND=127.0.0.1
SEARXNG_PORT=8080
SEARXNG_CONFIG_DIR=./config/searxng
SEARXNG_CPU_LIMIT=0.5
SEARXNG_MEMORY_LIMIT=512m
REDIS_CPU_LIMIT=0.25
REDIS_MEMORY_LIMIT=128m

# Do not put Discord tokens or LLM API keys in this Compose .env.
# Put Hermes secrets in runtime/*/hermes-data/.env after setup.
