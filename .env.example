# Hermes image
HERMES_IMAGE=nousresearch/hermes-agent:latest

# Host user IDs on Linux/WSL. Adjust with: id -u / id -g
HERMES_UID=1000
HERMES_GID=1000

# Runtime directories
HERMES_MAIN_DATA_DIR=./runtime/main/hermes-data
HERMES_OWASHOTA_DATA_DIR=./runtime/owashota/hermes-data
HERMES_WORKSPACE_DIR=./workspace
OPENVIKING_DATA_DIR=./runtime/openviking

# Gateway ports. Keep localhost-only unless exposed behind VPN/Tailscale.
HERMES_MAIN_GATEWAY_BIND=127.0.0.1
HERMES_MAIN_GATEWAY_PORT=8642
HERMES_OWASHOTA_GATEWAY_BIND=127.0.0.1
HERMES_OWASHOTA_GATEWAY_PORT=8643

# OpenViking
OPENVIKING_IMAGE=ghcr.io/volcengine/openviking:latest
OPENVIKING_BIND=127.0.0.1
OPENVIKING_PORT=1933
OPENVIKING_WITH_BOT=0

# Memory namespace separation
OPENVIKING_MAIN_ACCOUNT=personal
OPENVIKING_MAIN_USER=yanelmo
OPENVIKING_MAIN_AGENT=hermes-main
OPENVIKING_MAIN_API_KEY=change-me-main

OPENVIKING_OWASHOTA_ACCOUNT=owashota
OPENVIKING_OWASHOTA_USER=owashota
OPENVIKING_OWASHOTA_AGENT=hermes-owashota
OPENVIKING_OWASHOTA_API_KEY=change-me-owashota

# Do not commit real secrets.
# Put Discord tokens and LLM API keys in runtime/*/hermes-data/.env.
