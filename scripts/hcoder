#!/usr/bin/env bash
set -euo pipefail

repo="${BACKUP_SECRETARY_REPO:-$HOME/repo/backup-secretary}"
data="${HERMES_CODER_DATA:-$HOME/repo/backup-secretary-data/pc/coder/hermes-data}"
server="${OPENVIKING_ENDPOINT:-http://your-server:1933}"

cd "$repo"

if git diff --quiet && git diff --cached --quiet; then
  git pull --ff-only
else
  echo "backup-secretary has local changes; skipping git pull." >&2
fi

mkdir -p "$data/skills"
rsync -a "$repo/skills/" "$data/skills/"

# Reuse main config/SOUL as the default coder profile bootstrap when missing.
mkdir -p "$data"
[ -f "$data/SOUL.md" ] || cp "$repo/runtime/main/hermes-data/SOUL.md" "$data/SOUL.md"
[ -f "$data/config.yaml" ] || cp "$repo/runtime/main/hermes-data/config.yaml" "$data/config.yaml"

export HERMES_HOME="$data"
export OPENVIKING_ENDPOINT="$server"
export OPENVIKING_ACCOUNT="${OPENVIKING_ACCOUNT:-personal}"
export OPENVIKING_USER="${OPENVIKING_USER:-yanelmo}"
export OPENVIKING_AGENT="${OPENVIKING_AGENT:-coder}"

exec hermes chat
