#!/usr/bin/env bash
set -euo pipefail

repo="${BACKUP_SECRETARY_REPO:-$HOME/repo/backup-secretary}"
cd "$repo"

if git diff --quiet && git diff --cached --quiet; then
  echo "No changes to commit."
  exit 0
fi

git status --short

git add \
  compose.yaml .env.example Makefile \
  docker scripts docs skills knowledge \
  runtime/main/hermes-data/SOUL.md runtime/main/hermes-data/config.yaml \
  runtime/owashota/hermes-data/SOUL.md runtime/owashota/hermes-data/config.yaml \
  runtime/openviking/.gitkeep

git commit -m "${1:-update backup-secretary}"
git push
